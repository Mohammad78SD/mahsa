# Copy to .env and fill in. Never commit the real .env file.
# Load it before starting the app, e.g.:  set -a; source .env; set +a

# --- Django core ---
# Required in production. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# Set to true for local development only (enables a dev fallback secret key and media serving).
DJANGO_DEBUG=false
# Comma-separated hostnames served by this instance.
DJANGO_ALLOWED_HOSTS=panel.example.com,127.0.0.1
# Comma-separated origins (with scheme) allowed for CSRF, e.g. https://panel.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.example.com
# Optional cookie domain for the CSRF cookie (leave empty to use the default).
DJANGO_CSRF_COOKIE_DOMAIN=
# Optional path to the SQLite database file (default: ./db.sqlite3).
DJANGO_DB_PATH=

# --- Web push (VAPID keys; generate with `vapid --gen` from py-vapid) ---
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address sent to push services (used as mailto: claim).
VAPID_ADMIN_EMAIL=admin@example.com

# --- SMS gateway (ippanel) ---
SMS_API_KEY=your-ippanel-api-key
# Sender line number registered with the gateway.
SMS_SENDER=+98000000000
# Pattern codes created in the ippanel panel (OTP code and lunch list).
SMS_OTP_PATTERN=your-otp-pattern-code
SMS_LUNCH_PATTERN=your-lunch-pattern-code
# Comma-separated phone numbers that receive the daily lunch list.
SMS_LUNCH_RECIPIENTS=09120000000,09120000001

# --- Process manager (ecosystem.config.js) ---
# Port gunicorn binds to under pm2.
PORT=8002
